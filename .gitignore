# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Downloaded data: never committed (licences, size)
data/raw/
data/external/
data/processed/

# Reference documents (VATSIM vMATS, UK AIP): link to them, don't commit them
*.pdf

# Trained models and outputs
checkpoints/
models/
*.pt
*.pth
*.zip
# Training runs are kept on the record (run.json, episode logs, saved AIs, tests); their working logs aren't
!runs/**/*.zip
runs/*.log
runs/**/*.log
runs/competitor/
outputs/

# OS / editor
.DS_Store
.vscode/
.idea/

# Temporary recordings made while recording a milestone
media/
runs/**/model_latest.zip

# The look-ahead's recorded decisions (approach.ai.imitate collect): regenerated by the command in each folder's
# collect.json; sessions.csv, written when a round ends, keeps every session's summary
runs/imitate/data/**/*.npz
runs/imitate/data/**/session_*.json
# Sessions saved as a run goes, so it can carry on after a restart (the finished run's csv and json are kept)
runs/**/*.parts/
